# IDE files - apply globally
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files - apply globally
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Environment files - apply globally
.env
.env.local
.env.*.local

# Note: .env.template is safe to commit (contains no real credentials)

# Log files - apply globally
*.log

# Temporary files
temp/
tmp/

# Terraform state files - apply globally
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform directory
.terraform/
.terraform.lock.hcl

# Terraform variable files (except examples)
*.tfvars
!terraform.tfvars.example
!*.tfvars.example

# Auto-generated backend configuration files (environment-specific)
backend.tf
backend.tfvars
backend.env

# Terraform plan files
*.tfplan
tfplan
*.tfplan.json

# Azure Developer CLI environment files (contain subscription IDs)
.azure/*/
!.azure/.env.sample
